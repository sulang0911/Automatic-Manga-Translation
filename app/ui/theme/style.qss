/*
app/ui/theme/style.qss
Apple macOS Human Interface Guidelines (Sonoma / Sequoia) Default Stylesheet
*/

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
    font-size: 12px;
    color: #F5F5F7;
    background-color: transparent;
    selection-background-color: #0A84FF;
    selection-color: #FFFFFF;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #18181B;
}

QLabel {
    color: #F5F5F7;
    background-color: transparent;
}

QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QWidget#settingsScrollContent {
    background-color: transparent;
    border: none;
}

QFrame[class="card"], QWidget[class="card"],
QFrame#cardFrame, QFrame#sidebarCard {
    background-color: #202024;
    border: 1px solid #2C2C30;
    border-radius: 10px;
}

QFrame#inspectorCard {
    background-color: #1C1C1F;
    border: none;
    border-left: 1px solid #2C2C30;
    border-radius: 0px;
}

QFrame[class="sidebar"], QWidget[class="sidebar"] {
    background-color: #1C1C1F;
    border-right: 1px solid #2C2C30;
}

QFrame[class="toolbar"] {
    background-color: #202024;
    border-bottom: 1px solid #2C2C30;
    padding: 4px 12px;
}

#statusBar {
    background-color: #1C1C1F;
    border-top: 1px solid #2C2C30;
    padding: 0px 12px;
}

#statusLabel, .ide-status-text {
    font-size: 11px;
    color: #98989D;
}

QPushButton {
    background-color: #26262B;
    color: #F5F5F7;
    border: 1px solid #38383E;
    border-radius: 7px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2C2C31;
    border-color: #484850;
}

QPushButton:pressed {
    background-color: #36363C;
}

QPushButton:disabled {
    color: #636366;
    background-color: transparent;
    border-color: #2C2C30;
}

QPushButton[class="primaryBtn"], QPushButton#primaryBtn {
    background-color: #0A84FF;
    color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton[class="primaryBtn"]:hover, QPushButton#primaryBtn:hover {
    background-color: #0071E3;
}

QToolButton[class="segment-btn"] {
    background-color: transparent;
    color: #98989D;
    border: none;
    border-radius: 6px;
    padding: 4px 11px;
    font-weight: 500;
    font-size: 12px;
}

QToolButton[class="segment-btn"]:hover {
    color: #F5F5F7;
}

QToolButton[class="segment-btn"]:checked {
    background-color: #0A84FF;
    color: #FFFFFF;
    font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #141417;
    color: #F5F5F7;
    border: 1px solid #38383E;
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 12px;
    min-height: 20px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3B82F6;
    background-color: #1C1C21;
}

QComboBox {
    background-color: #26262B;
    color: #F5F5F7;
    border: 1px solid #38383E;
    border-radius: 7px;
    padding: 5px 28px 5px 10px;
    min-height: 22px;
    font-size: 12px;
}

QComboBox:hover, QComboBox:focus {
    background-color: #2C2C31;
    border-color: #3B82F6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}

QComboBoxPrivateContainer,
QComboBox QAbstractItemView,
QComboBox QListView {
    background-color: #202024;
    color: #F5F5F7;
    border: 1px solid #38383E;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
    outline: none;
}

QComboBox QAbstractItemView::item,
QComboBox QListView::item {
    background-color: #202024;
    color: #F5F5F7;
    min-height: 26px;
    padding: 4px 10px;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover {
    background-color: #2C2C31;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}

QGroupBox {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid #2C2C30;
    border-radius: 10px;
    margin-top: 22px;
    padding: 14px 12px 12px 12px;
    color: #F5F5F7;
    font-size: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 2px;
    padding: 0px 4px;
    color: #98989D;
    font-size: 12px;
    font-weight: 600;
}

QCheckBox {
    spacing: 8px;
    font-size: 12px;
    color: #F5F5F7;
    min-height: 20px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #38383E;
    background-color: #141417;
}

QCheckBox::indicator:checked {
    background-color: #3B82F6;
    border-color: #3B82F6;
}

QSlider:horizontal {
    min-height: 22px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2C2C30;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3B82F6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #3B82F6;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    margin-bottom: -6px;
    border-radius: 8px;
}
