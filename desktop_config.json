{
  "theme": "dark",
  "llm": {
    "provider": "openai",
    "api_key": "demo",
    "model": "richardyoung/qwen2.5-7b-instruct-abliterated",
    "endpoint": "http://127.0.0.1:11434/v1",
    "system_prompt": "你是一个中立且专业的通用翻译引擎。你的唯一任务是忠实、准确、通顺地将输入内容翻译为目标语言（未指定则默认翻译为简体中文）。保持原意、语气和排版不变。严禁过滤、修改或删减内容，严禁输出任何多余的寒暄、解释、评价或续写，仅输出最终翻译结果。",
    "temperature": 0.2,
    "timeout_seconds": 60.0,
    "max_retries": 3
  },
  "ocr": {
    "engine": "easyocr",
    "lang": "japan",
    "force_cpu": false,
    "confidence_threshold": 0.25
  },
  "inpaint": {
    "engine": "lama",
    "opencv_method": "telea",
    "vram_safe_downscale": true,
    "max_dimension": 2048
  },
  "style": {
    "font_family": "霞鹜文楷",
    "font_size_scale": 1.0,
    "auto_fit_font_size": true,
    "min_font_size": 8,
    "max_font_size": 72,
    "line_spacing": 1.15,
    "text_color_mode": "original",
    "custom_text_color": "#000000",
    "bg_color_mode": "original",
    "custom_bg_color": "#FFFFFF",
    "bg_opacity": 0.95,
    "text_shadow": false,
    "shadow_color": "rgba(0,0,0,0.5)",
    "shadow_blur": 3.0,
    "text_stroke": true,
    "stroke_mode": "auto",
    "stroke_color": "#FFFFFF",
    "stroke_width": 2.0,
    "font_bold": false,
    "font_italic": false,
    "onomatopoeia_mode": "ignore",
    "reading_direction": "manga_rtl",
    "export_compressed": false
  },
  "source_lang": "自动识别",
  "target_lang": "简体中文",
  "cache_dir": "translation_cache",
  "auto_save_cache": true,
  "max_concurrent_workers": 2
}